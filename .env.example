# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Any single key is enough to run; more keys = better coverage.

# https://www.virustotal.com/gui/my-apikey  (free: 4 requests/min, 500/day)
VT_API_KEY=

# https://www.abuseipdb.com/account/api  (free: 1,000 checks/day)
ABUSEIPDB_API_KEY=

# https://auth.abuse.ch/  (free Auth-Key for URLhaus; also used for MalwareBazaar)
URLHAUS_AUTH_KEY=

# Optional: only if you want a different abuse.ch key for MalwareBazaar.
MALWAREBAZAAR_AUTH_KEY=

# Team Cymru's Malware Hash Registry needs no key.
